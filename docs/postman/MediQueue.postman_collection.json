            }
          ]
        },
        {
          "name": "Doctor Application Statistics",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{admin_token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/doctor-applications/statistics",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "doctor-applications", "statistics"]
            }
          },
          "response": [
            {
              "name": "Statistics",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\n  \"success\": true,\n  \"message\": \"Doctor application statistics retrieved successfully\",\n  \"data\": {\"total\": 100, \"pending\": 20, \"approved\": 70, \"rejected\": 10}\n}"
            }
          ]
        },
        {
          "name": "List Doctor Applications",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{admin_token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/doctor-applications?page=1&per_page=15&sort=newest&verification_status=pending",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "doctor-applications"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "15" },
                { "key": "sort", "value": "newest" },
                { "key": "verification_status", "value": "pending" },
                { "key": "search", "value": "Omar", "disabled": true },
                { "key": "specialty_id", "value": "{{specialty_id}}", "disabled": true },
                { "key": "application_date", "value": "2026-08-18", "disabled": true }
              ]
            }
          },
          "response": [
            {
              "name": "Paginated applications",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\n  \"data\": [{\"doctor_id\": 2, \"full_name\": \"Omar Hassan\", \"email\": \"doctor@example.test\", \"phone\": \"+15550200001\", \"profile_image\": null, \"specialty\": {\"id\": 1, \"name\": \"Cardiology\"}, \"medical_license_number\": \"EXAMPLE-LICENSE-001\", \"years_of_experience\": 7, \"verification_status\": \"pending\", \"application_submitted_at\": \"2026-08-18T12:00:00.000000Z\", \"reviewed_at\": null, \"rejection_reason\": null}],\n  \"links\": {},\n  \"meta\": {\"current_page\": 1, \"per_page\": 15, \"total\": 1},\n  \"success\": true,\n  \"message\": \"Doctor applications retrieved successfully\"\n}"
            }
          ]
        },
