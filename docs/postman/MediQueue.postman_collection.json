            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/pdf" }],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/doctor-applications/{{doctor_id}}/documents/{{document_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "doctor-applications", "{{doctor_id}}", "documents", "{{document_id}}"],
              "query": [{ "key": "download", "value": "1", "disabled": true }]
            },
            "description": "Streams a private document inline. Enable download=1 to download it as an attachment."
          },
          "response": [
