          "name": "View Doctor Application",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{admin_token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/doctor-applications/{{doctor_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "doctor-applications", "{{doctor_id}}"]
            }
          },
          "response": [
            {
              "name": "Application details",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\n  \"data\": {\"doctor_id\": 2, \"full_name\": \"Omar Hassan\", \"verification_status\": \"pending\", \"clinic\": null, \"verification_documents\": [{\"id\": 1, \"document_type\": \"medical_license\", \"original_name\": \"license.pdf\", \"authorized_endpoint\": \"/api/v1/admin/doctor-applications/2/documents/1\"}], \"review\": null, \"review_history\": []},\n  \"success\": true,\n  \"message\": \"Doctor application retrieved successfully\"\n}"
            }
          ]
        },
        {
          "name": "Approve Doctor",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{admin_token}}", "type": "string" }]
            },
            "method": "PATCH",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" } } },
            "url": {
              "raw": "{{base_url}}/api/v1/admin/doctor-applications/{{doctor_id}}/approve",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "doctor-applications", "{{doctor_id}}", "approve"]
            }
          },
          "response": [
            {
              "name": "Approved",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\n  \"data\": {\"doctor_id\": 2, \"verification_status\": \"approved\", \"approved_at\": \"2026-08-18T12:00:00.000000Z\", \"rejection_reason\": null},\n  \"success\": true,\n  \"message\": \"Doctor application approved successfully\"\n}"
            },
            {
              "name": "Already reviewed",
              "status": "Conflict",
              "code": 409,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\n  \"message\": \"This doctor application has already been reviewed.\"\n}"
            }
          ]
        },
        {
          "name": "Reject Doctor",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{admin_token}}", "type": "string" }]
            },
            "method": "PATCH",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rejection_reason\": \"The medical license document is unclear.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/admin/doctor-applications/{{doctor_id}}/reject",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "doctor-applications", "{{doctor_id}}", "reject"]
            }
          },
          "response": [
            {
              "name": "Rejected",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\n  \"data\": {\"doctor_id\": 2, \"verification_status\": \"rejected\", \"approved_at\": null, \"rejection_reason\": \"The medical license document is unclear.\"},\n  \"success\": true,\n  \"message\": \"Doctor application rejected successfully\"\n}"
            }
          ]
