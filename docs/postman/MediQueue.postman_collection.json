{
  "info": {
    "_postman_id": "bd51ddba-68d2-4aad-bc55-ebea1c57a595",
    "name": "MediQueue API",
    "description": "Laravel backend requests for patient, doctor, and platform-admin authentication and doctor verification. Import the MediQueue Local environment before running requests. All included credentials are non-secret examples.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Patient Authentication",
      "item": [
        {
          "name": "Patient Registration",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Mona\",\n  \"last_name\": \"Ali\",\n  \"email\": \"patient@example.test\",\n  \"phone\": \"+15550100001\",\n  \"password\": \"Example#Pass1\",\n  \"password_confirmation\": \"Example#Pass1\",\n  \"date_of_birth\": \"1995-05-12\",\n  \"gender\": \"female\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/patient/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "patient", "auth", "register"]
            },
            "description": "Creates a patient user/profile and returns a Sanctum token. The role is assigned by the backend."
          },
          "response": [
            {
              "name": "Created",
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\n  \"success\": true,\n  \"message\": \"Registration successful\",\n  \"data\": {\n    \"user\": {\"id\": 1, \"first_name\": \"Mona\", \"last_name\": \"Ali\", \"email\": \"patient@example.test\", \"phone\": \"+15550100001\"},\n    \"profile\": {\"date_of_birth\": \"1995-05-12\", \"gender\": \"female\"},\n    \"role\": \"patient\",\n    \"verification_status\": null,\n    \"token\": \"1|example-token-returned-by-api\",\n    \"token_type\": \"Bearer\"\n  }\n}"
            }
          ]
        },
        {
          "name": "Patient Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (pm.response.code === 200 && json.success && json.data && json.data.token) {",
                  "    pm.environment.set('patient_token', json.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patient@example.test\",\n  \"password\": \"Example#Pass1\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/patient/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "patient", "auth", "login"]
            },
            "description": "Logs in a patient and automatically saves the token to patient_token."
          },
          "response": [
            {
              "name": "Login successful",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\n  \"success\": true,\n  \"message\": \"Login successful\",\n  \"data\": {\"role\": \"patient\", \"verification_status\": null, \"token\": \"1|example-token-returned-by-api\", \"token_type\": \"Bearer\"}\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Doctor Authentication",
      "item": [
        {
          "name": "Doctor Registration",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Omar\",\n  \"last_name\": \"Hassan\",\n  \"email\": \"doctor@example.test\",\n  \"phone\": \"+15550200001\",\n  \"password\": \"Example#Pass1\",\n  \"password_confirmation\": \"Example#Pass1\",\n  \"specialty_id\": {{specialty_id}},\n  \"medical_license_number\": \"EXAMPLE-LICENSE-001\",\n  \"years_of_experience\": 7,\n  \"bio\": \"Example physician biography.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/doctor/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "doctor", "auth", "register"]
            },
            "description": "Creates a pending doctor application. specialty_id is a collection variable."
          },
          "response": [
            {
              "name": "Pending doctor created",
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\n  \"success\": true,\n  \"message\": \"Registration successful\",\n  \"data\": {\"role\": \"doctor\", \"verification_status\": \"pending\", \"token\": \"2|example-token-returned-by-api\", \"token_type\": \"Bearer\"}\n}"
            }
          ]
        },
        {
          "name": "Doctor Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (pm.response.code === 200 && json.success && json.data && json.data.token) {",
                  "    pm.environment.set('doctor_token', json.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"doctor@example.test\",\n  \"password\": \"Example#Pass1\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/doctor/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "doctor", "auth", "login"]
            },
            "description": "Logs in a doctor and automatically saves the token to doctor_token."
          },
          "response": [
            {
              "name": "Login successful",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\n  \"success\": true,\n  \"message\": \"Login successful\",\n  \"data\": {\"role\": \"doctor\", \"verification_status\": \"pending\", \"token\": \"2|example-token-returned-by-api\", \"token_type\": \"Bearer\"}\n}"
            }
          ]
        },
        {
          "name": "Doctor Verification Status",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{doctor_token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/doctor/auth/verification-status",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "doctor", "auth", "verification-status"]
            }
          },
          "response": [
            {
              "name": "Rejected example",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\n  \"success\": true,\n  \"message\": \"Verification status retrieved successfully\",\n  \"data\": {\"verification_status\": \"rejected\", \"reviewed_at\": \"2026-08-18T12:00:00.000000Z\", \"approved_at\": null, \"rejection_reason\": \"The medical license document is unclear.\"}\n}"
            }
          ]
        }
      ]
