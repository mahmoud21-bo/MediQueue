            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.test\",\n  \"password\": \"Example#Admin1\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/admin/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "auth", "login"]
            },
            "description": "Logs in a seeded platform_admin and automatically saves the token to admin_token. There is no public admin registration endpoint."
          },
          "response": [
            {
              "name": "Login successful",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\n  \"success\": true,\n  \"message\": \"Login successful\",\n  \"data\": {\"user\": {\"id\": 3, \"email\": \"admin@example.test\"}, \"profile\": null, \"role\": \"platform_admin\", \"verification_status\": null, \"token\": \"3|example-token-returned-by-api\", \"token_type\": \"Bearer\"}\n}"
            }
          ]
        },
        {
          "name": "Admin Me",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{admin_token}}", "type": "string" }]
